{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "exclude": [
    "src/**/__tests__/**",
    "src/dev/**",
    "src/main.ts",
    "src/preview/**",
    "src/test-utils/**",
    "src/App.vue"
  ]
}
